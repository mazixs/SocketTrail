# Background collection: the connection history builds up before the window is opened.
# Optional:
#   mkdir -p ~/.config/systemd/user
#   cp assets/sockettrail.service ~/.config/systemd/user/
#   systemctl --user enable --now sockettrail
# After that the shortcut or the sockettrail command just opens the window of the
# running instance instead of starting a second one.
[Unit]
Description=SocketTrail - network connection collection by process
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/sockettrail --no-open
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
